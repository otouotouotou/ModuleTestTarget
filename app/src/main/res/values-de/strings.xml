    <string name="clipboard_state_empty">(nicht lesbar)</string>
    <string name="clipboard_state_copied">Kopiert</string>
    <string name="clipboard_note">Zum Prüfen der Asrish-Sperre für das Lesen der Zwischenablage. Bei aktiver Sperre sind Inhalte aus anderen Apps nicht lesbar, hier kopierte Inhalte schon.</string>
