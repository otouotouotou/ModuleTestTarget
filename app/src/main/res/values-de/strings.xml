<resources>
    <string name="app_name">ModuleTestTarget</string>
    <string name="subtitle">Ziel-App zum Prüfen von Modulen v%1$s</string>
    <string name="section_status">■ Aktueller Status</string>
    <string name="status_note">Hier siehst du, wie Drehung, Vollbild, Bildschirm-an, Schriftgröße und App-Sprache wirken.</string>
    <string name="section_screenshot">■ Test der Screenshot-Steuerung</string>
    <string name="toggle_add">FLAG_SECURE setzen</string>
    <string name="toggle_remove">FLAG_SECURE entfernen</string>
    <string name="screenshot_note">Bei ON sind Screenshots normalerweise nicht möglich. Erfolg, wenn ein Modul mit Erlauben sie möglich macht. Bei OFF Erfolg, wenn Blockieren sie verhindert.</string>
    <string name="section_text_sample">■ Textbeispiele</string>
    <string name="text_sample_note">Zum Prüfen von Schriftgröße und DPI sowie von Übersetzungsmodulen.</string>
    <string name="locale_sample">Dies ist ein Satz zum Testen der Sprache.</string>
    <string name="section_notification">■ Benachrichtigungstest</string>
    <string name="button_notify">Testbenachrichtigung anzeigen</string>
    <string name="notification_note">Unten werden flags / defaults / sound des gesendeten Benachrichtigungsobjekts angezeigt. Schreibt ein Modul sie beim Senden um, ändern sich die Werte. Dauerhaft = nicht wegwischbar; wiederholend = Ton läuft in Schleife. Beim ersten Tippen erscheint der Berechtigungsdialog.</string>
    <string name="section_sound">■ Soundtest</string>
    <string name="button_sound">Testsound abspielen (2 s Piepton)</string>
    <string name="sound_note">Zum Prüfen von Stummschalt-Funktionen. Spielt einen 2 Sekunden langen Piepton in Medienlautstärke (STREAM_MUSIC). Erfolg, wenn er bei Stummschaltung durch ein Modul nicht zu hören ist.</string>
