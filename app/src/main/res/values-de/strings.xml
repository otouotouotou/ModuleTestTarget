    <!-- レイアウト方向テスト -->
    <string name="section_layout_direction">■ Test der Layoutrichtung (Force LTR)</string>
    <string name="status_layout_config">Richtung (Konfiguration): %1$s</string>
    <string name="status_layout_root">Richtung (Root-View): %1$s</string>
    <string name="layout_start_label">START</string>
    <string name="layout_end_label">END</string>
    <string name="layout_row_sample">Diese Zeile kehrt ihre Reihenfolge mit der Richtung um</string>
    <string name="layout_start_aligned">Am Start ausgerichteter Text</string>
    <string name="layout_direction_note">Mit einer RTL-Sprache wie Arabisch wandert START normalerweise nach rechts und das Layout spiegelt sich. Wirkt Force LTR, bleibt die Sprache, aber die Richtung ist auf LTR fixiert und START ist wieder links.</string>
    <string name="section_clipboard">■ Zwischenablage-Test</string>
    <string name="clipboard_sample">Testtext</string>
    <string name="button_clipboard_copy">In Zwischenablage kopieren</string>
    <string name="button_clipboard_read">Zwischenablage lesen</string>
