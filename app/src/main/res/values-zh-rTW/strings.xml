    <!-- レイアウト方向テスト -->
    <string name="section_layout_direction">■ 版面方向測試 (Force LTR)</string>
    <string name="status_layout_config">設定方向: %1$s</string>
    <string name="status_layout_root">根視圖方向: %1$s</string>
    <string name="layout_start_label">START</string>
    <string name="layout_end_label">END</string>
    <string name="layout_row_sample">這一行會隨方向反轉順序</string>
    <string name="layout_start_aligned">按 Start 對齊的文字</string>
    <string name="layout_direction_note">將應用程式語言設為阿拉伯語等 RTL 語言時，START 通常會移到右側，整個版面鏡像。Force LTR 生效後，語言不變，方向固定為 LTR，START 回到左側。</string>
    <string name="section_clipboard">■ 剪貼簿測試</string>
    <string name="clipboard_sample">測試文字</string>
    <string name="button_clipboard_copy">複製到剪貼簿</string>
    <string name="button_clipboard_read">讀取剪貼簿</string>
    <string name="clipboard_state_none">尚未讀取</string>
    <string name="clipboard_state_empty">(無法讀取)</string>
    <string name="clipboard_state_copied">已複製</string>
    <string name="clipboard_note">用於檢查 Asrish 的「阻止讀取剪貼簿」。開啟阻止後，在其他應用程式中複製的內容無法讀取，在本應用程式中複製的內容可以讀取。</string>
