<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">ModuleTestTarget</string>
    <string name="subtitle">用於驗證模組效果的目標應用程式 v%1$s</string>
    <string name="section_status">■ 目前狀態</string>
    <string name="status_note">可在這裡查看螢幕旋轉、全螢幕、保持亮起、字體縮放和應用程式專屬語言的生效情形。</string>
    <string name="section_screenshot">■ 螢幕截圖控制測試</string>
    <string name="toggle_add">加上 FLAG_SECURE</string>
    <string name="toggle_remove">移除 FLAG_SECURE</string>
    <string name="screenshot_note">開啟時通常無法截圖。若模組設定為「允許」後可以截圖，則成功。關閉時若設定為「禁止」後無法截圖，則成功。</string>
    <string name="section_text_sample">■ 文字範例</string>
    <string name="text_sample_note">用於查看字體縮放、DPI 的效果，以及驗證翻譯模組。</string>
    <string name="locale_sample">這是用於語言測試的句子。</string>
    <string name="section_notification">■ 通知測試</string>
    <string name="button_notify">傳送測試通知</string>
    <string name="notification_note">下方顯示所發送通知物件的 flags / defaults / sound。如果模組在發送時改寫，這些值會隨之變化。常駐通知無法滑動清除；重複響鈴通知會循環播放聲音。首次點按會顯示權限對話框。</string>
    <string name="section_sound">■ 音效測試</string>
    <string name="button_sound">播放測試音（2 秒嗶聲）</string>
    <string name="sound_note">用於驗證靜音功能。以媒體音量 (STREAM_MUSIC) 播放 2 秒嗶聲。若被模組靜音後沒有聲音，則成功。</string>
    <string name="status_orientation">方向: %1$s</string>
    <string name="orientation_portrait">直向 (portrait)</string>
    <string name="orientation_landscape">橫向 (landscape)</string>
    <string name="orientation_unknown">未知</string>
