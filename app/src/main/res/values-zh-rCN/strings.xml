<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">ModuleTestTarget</string>
    <string name="subtitle">用于验证模块效果的目标应用 v%1$s</string>
    <string name="section_status">■ 当前状态</string>
    <string name="status_note">可在这里查看屏幕旋转、全屏、保持亮屏、字体缩放和应用专属语言的生效情况。</string>
    <string name="section_screenshot">■ 截图控制测试</string>
    <string name="toggle_add">添加 FLAG_SECURE</string>
    <string name="toggle_remove">移除 FLAG_SECURE</string>
    <string name="screenshot_note">开启时通常无法截图。若模块设置为“允许”后可以截图，则成功。关闭时若设置为“禁止”后无法截图，则成功。</string>
    <string name="section_text_sample">■ 文本示例</string>
    <string name="text_sample_note">用于查看字体缩放、DPI 的效果，以及验证翻译模块。</string>
    <string name="locale_sample">这是用于语言测试的句子。</string>
    <string name="section_notification">■ 通知测试</string>
    <string name="button_notify">发送测试通知</string>
    <string name="notification_note">下方显示所发送通知对象的 flags / defaults / sound。如果模块在发送时改写，这些值会随之变化。常驻通知无法滑动清除；重复响铃通知会循环播放声音。首次点击会显示权限对话框。</string>
    <string name="section_sound">■ 声音测试</string>
    <string name="button_sound">播放测试音（2秒蜂鸣）</string>
    <string name="sound_note">用于验证静音功能。以媒体音量 (STREAM_MUSIC) 播放 2 秒蜂鸣音。若被模块静音后没有声音，则成功。</string>
    <string name="status_orientation">方向: %1$s</string>
    <string name="orientation_portrait">竖屏 (portrait)</string>
    <string name="orientation_landscape">横屏 (landscape)</string>
    <string name="orientation_unknown">未知</string>
    <string name="status_screen_px">屏幕: %1$d x %2$d px</string>
    <string name="status_screen_dp">屏幕: %1$d x %2$d dp</string>
    <string name="status_smallest_width">最小宽度: %1$d dp</string>
    <string name="status_density">density: %1$d dpi (x%2$s)</string>
    <string name="status_font_scale">字体缩放: x%1$s</string>
    <string name="status_locale">语言区域: %1$s (%2$s)</string>
    <string name="status_elapsed">本画面显示时长: %1$s</string>
    <string name="status_flag_secure">FLAG_SECURE: %1$s</string>
    <string name="status_show_when_locked">在锁屏上显示: %1$s</string>
    <string name="status_swl_showing">显示中</string>
    <string name="status_swl_unknown">无法判定</string>
    <string name="status_keyguard_locked">屏幕已锁定: %1$s</string>
    <string name="secure_state">当前 FLAG_SECURE: %1$s</string>
    <string name="notif_channel">测试通知</string>
    <string name="notif_title">测试通知</string>
    <string name="notif_text">这是来自 ModuleTestTarget 的测试通知。</string>
    <string name="button_notify_ongoing">发送常驻通知</string>
    <string name="button_notify_insistent">发送重复响铃通知</string>
    <string name="button_notify_sound">发送带声音通知</string>
    <string name="button_notify_cancel_all">清除全部通知</string>
    <string name="notif_sound_channel">声音测试通知</string>
    <string name="notif_kind_normal">普通</string>
    <string name="notif_kind_ongoing">常驻</string>
    <string name="notif_kind_sound">带声音</string>
    <string name="notif_kind_insistent">重复响铃</string>
    <string name="notif_state_none">尚未发送</string>
    <string name="notif_state_kind">最近发送: %1$s</string>

    <!-- レイアウト方向テスト -->
    <string name="section_layout_direction">■ 布局方向测试 (Force LTR)</string>
    <string name="status_layout_config">配置方向: %1$s</string>
    <string name="status_layout_root">根视图方向: %1$s</string>
    <string name="layout_start_label">START</string>
    <string name="layout_end_label">END</string>
    <string name="layout_row_sample">这一行会随方向反转顺序</string>
    <string name="layout_start_aligned">按 Start 对齐的文本</string>
    <string name="layout_direction_note">将应用语言设为阿拉伯语等 RTL 语言时，START 通常会移到右侧，整个布局镜像。Force LTR 生效后，语言不变，方向固定为 LTR，START 回到左侧。</string>
    <string name="section_clipboard">■ 剪贴板测试</string>
    <string name="clipboard_sample">测试文本</string>
    <string name="button_clipboard_copy">复制到剪贴板</string>
    <string name="button_clipboard_read">读取剪贴板</string>
    <string name="clipboard_state_none">尚未读取</string>
    <string name="clipboard_state_empty">(无法读取)</string>
    <string name="clipboard_state_copied">已复制</string>
    <string name="clipboard_note">用于检查 Asrish 的“阻止读取剪贴板”。开启阻止后，在其他应用中复制的内容无法读取，在本应用中复制的内容可以读取。</string>
    <string name="status_rotation">旋转: %1$d°</string>
    <string name="status_flag_keep_screen_on">FLAG_KEEP_SCREEN_ON: %1$s</string>
    <string name="section_window_flags">■ 窗口标志测试</string>
    <string name="toggle_keep_on_add">添加 FLAG_KEEP_SCREEN_ON</string>
    <string name="toggle_keep_on_remove">移除 FLAG_KEEP_SCREEN_ON</string>
    <string name="screen_on_note">开启时屏幕通常保持常亮。若模块设为"不保持常亮"后上方状态变为 OFF 则成功。</string>
    <string name="toggle_swl_add">启用锁屏显示</string>
    <string name="toggle_swl_remove">禁用锁屏显示</string>
    <string name="swl_note">在本应用自身启用锁屏显示的状态下，若模块设为"不显示"后它不再出现在锁屏上则成功。</string>
</resources>
