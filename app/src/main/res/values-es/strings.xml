    <string name="app_name">ModuleTestTarget</string>
    <string name="subtitle">App de destino para comprobar módulos v%1$s</string>
    <string name="section_status">■ Estado actual</string>
    <string name="status_note">Aquí puedes ver cómo afectan a esta app la rotación, la pantalla completa, mantener la pantalla encendida, la escala de fuente y el idioma por app.</string>
    <string name="section_screenshot">■ Prueba de control de capturas</string>
    <string name="toggle_add">Añadir FLAG_SECURE</string>
    <string name="toggle_remove">Quitar FLAG_SECURE</string>
    <string name="screenshot_note">Con ON, normalmente no se pueden hacer capturas. Es correcto si un módulo en Permitir deja hacerlas. Con OFF, es correcto si Bloquear las impide.</string>
    <string name="section_text_sample">■ Ejemplos de texto</string>
    <string name="text_sample_note">Para comprobar la escala de fuente, el DPI y los módulos de traducción.</string>
    <string name="locale_sample">Esta es una frase para probar el idioma.</string>
    <string name="section_notification">■ Prueba de notificación</string>
    <string name="button_notify">Mostrar notificación de prueba</string>
    <string name="notification_note">Abajo se muestran los flags / defaults / sound del objeto de notificación enviado. Si un módulo los reescribe al enviar, los valores cambian. La persistente no se puede deslizar para borrar; la repetitiva repite el sonido. La primera vez aparecerá el diálogo de permiso.</string>
    <string name="section_sound">■ Prueba de sonido</string>
    <string name="button_sound">Reproducir sonido de prueba (pitido de 2 s)</string>
    <string name="sound_note">Para comprobar funciones de silencio. Reproduce un pitido de 2 segundos con el volumen multimedia (STREAM_MUSIC). Es correcto si no suena cuando un módulo lo silencia.</string>
