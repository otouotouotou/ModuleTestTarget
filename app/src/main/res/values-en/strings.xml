    <string name="screen_on_note">When ON, the screen normally stays on. Success if a module set to "Don\'t keep on" makes the status above read OFF.</string>
    <string name="toggle_swl_add">Enable show on lock screen</string>
    <string name="toggle_swl_remove">Disable show on lock screen</string>
    <string name="swl_note">With this app\'s own show-on-lock enabled, success if a module set to "Don\'t show" keeps it off the lock screen.</string>
