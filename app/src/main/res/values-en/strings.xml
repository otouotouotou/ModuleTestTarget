<resources>
    <string name="app_name">ModuleTestTarget</string>
    <string name="subtitle">Target app for verifying modules v%1$s</string>
    <string name="section_status">■ Current status</string>
    <string name="status_note">Shows how rotation, fullscreen, keep-screen-on, font scale and per-app language are affecting this app.</string>
    <string name="section_screenshot">■ Screenshot control test</string>
    <string name="toggle_add">Add FLAG_SECURE</string>
    <string name="toggle_remove">Remove FLAG_SECURE</string>
    <string name="screenshot_note">When ON, screenshots are normally blocked. Success if a module set to Allow lets you take one. When OFF, success if Block prevents it.</string>
    <string name="section_text_sample">■ Text samples</string>
    <string name="text_sample_note">For checking font scale / DPI appearance and translation modules.</string>
    <string name="locale_sample">This is a sentence for language testing.</string>
    <string name="section_notification">■ Notification test</string>
    <string name="button_notify">Post a test notification</string>
    <string name="notification_note">The flags / defaults / sound of the posted notification object are shown below. If a module rewrites them at posting time, the values here change. Ongoing cannot be swiped away; insistent loops the sound. The first tap shows the permission dialog.</string>
    <string name="section_sound">■ Sound test</string>
    <string name="button_sound">Play test sound (2s beep)</string>
    <string name="sound_note">For checking mute features. Plays a 2-second beep at media volume (STREAM_MUSIC). Success if it stays silent when muted by a module.</string>
