    <string name="layout_row_sample">This row flips its order with the layout direction</string>
    <string name="layout_start_aligned">Start-aligned text</string>
    <string name="layout_direction_note">With an RTL per-app language such as Arabic, START normally moves to the right and the whole layout mirrors. If Force LTR works, the language stays but the direction is pinned to LTR and START returns to the left.</string>
